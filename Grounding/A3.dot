digraph ExclusiveChoice {
    rankdir=LR;
    
    // Stati
    s31 [shape = circle];
    s33 [shape = circle, initial = true];
    s3abs[shape = circle, abstract = true];
    
    // Stato finale
    s30  [shape = doublecircle];
    s32 [shape = doublecircle];
    
    // Transizioni
    s30 -> s30 [label="not c"];
    s32 -> s32 [label="not a"];
    s33 -> s33 [labe="not a"];
    s33 -> s33 [labe="not c"];
    s30 -> s31 [label="c"];
    s32 -> s31 [label="a"];
    s33 -> s32 [label="c"];
    s33 -> s30 [label="a"];
    s31 -> s31 [label="*"];
}
