digraph ExclusiveChoice {
    rankdir=LR;
    
    // Stati
    node [shape = circle];
    s31;
    s32;
    s33;
    
    // Stato finale
    node [shape = doublecircle];
    s30;
    
    // Transizioni
    s30 -> s30 [label="not c"];
    s32 -> s32 [label="not a"];
    s33 -> s33 [labe="not a"];
    s33 -> s33 [labe="not c"];
    s30 -> s31 [label="c"];
    s32 -> s31 [label="a"];
    s33 -> s32 [label="c"];
    s33 -> s30 [label="a"];
    s31 -> s31 [label="*"];
}
