(define (domain declare_full)
  (:requirements :strips :negative-preconditions)
  (:predicates
    (first)
    (forbidden)
    (ended)
    (done_admission_ic)
    (next_admission_ic)
    (last_admission_ic)
    (unique_admission_ic)
    (done_crp)
    (next_crp)
    (last_crp)
    (unique_crp)
    (done_er_registration)
    (next_er_registration)
    (last_er_registration)
    (unique_er_registration)
    (done_er_sepsis_triage)
    (next_er_sepsis_triage)
    (last_er_sepsis_triage)
    (unique_er_sepsis_triage)
    (done_er_triage)
    (next_er_triage)
    (last_er_triage)
    (unique_er_triage)
    (done_iv_antibiotics)
    (next_iv_antibiotics)
    (last_iv_antibiotics)
    (unique_iv_antibiotics)
    (done_lacticacid)
    (next_lacticacid)
    (last_lacticacid)
    (unique_lacticacid)
    (done_leucocytes)
    (next_leucocytes)
    (last_leucocytes)
    (unique_leucocytes)
    (done_release_b)
    (next_release_b)
    (last_release_b)
    (unique_release_b)
    (done_release_c)
    (next_release_c)
    (last_release_c)
    (unique_release_c)
    (done_release_d)
    (next_release_d)
    (last_release_d)
    (unique_release_d)
    (done_release_e)
    (next_release_e)
    (last_release_e)
    (unique_release_e)
    (pending_crp_er_registration)
    (pending_crp_er_sepsis_triage)
    (pending_crp_er_triage)
    (pending_crp_lacticacid)
    (pending_crp_leucocytes)
    (pending_er_registration_crp)
    (pending_er_registration_er_sepsis_triage)
    (pending_er_registration_er_triage)
    (pending_er_registration_lacticacid)
    (pending_er_registration_leucocytes)
    (pending_er_sepsis_triage_crp)
    (pending_er_sepsis_triage_er_registration)
    (pending_er_sepsis_triage_er_triage)
    (pending_er_sepsis_triage_lacticacid)
    (pending_er_sepsis_triage_leucocytes)
    (pending_er_triage_crp)
    (pending_er_triage_er_registration)
    (pending_er_triage_er_sepsis_triage)
    (pending_er_triage_lacticacid)
    (pending_er_triage_leucocytes)
    (pending_iv_antibiotics_lacticacid)
    (pending_lacticacid_crp)
    (pending_lacticacid_er_registration)
    (pending_lacticacid_er_sepsis_triage)
    (pending_lacticacid_er_triage)
    (pending_lacticacid_iv_antibiotics)
    (pending_lacticacid_leucocytes)
    (pending_leucocytes_crp)
    (pending_leucocytes_er_registration)
    (pending_leucocytes_er_sepsis_triage)
    (pending_leucocytes_er_triage)
    (pending_leucocytes_lacticacid)
  )

  (:action admission_ic
    :parameters ()
    :precondition (and (first) (forbidden))
    :effect (and )
  )

  (:action crp
    :parameters ()
    :precondition (and (done_er_registration) (done_er_triage) (first))
    :effect (and (done_crp) (not (pending_er_registration_crp)) (not (pending_er_sepsis_triage_crp)) (not (pending_er_triage_crp)) (not (pending_lacticacid_crp)) (not (pending_leucocytes_crp)) (when (not (done_er_sepsis_triage)) (pending_crp_er_sepsis_triage)) (when (not (done_lacticacid)) (pending_crp_lacticacid)) (when (not (done_leucocytes)) (pending_crp_leucocytes)))
  )

  (:action er_registration
    :parameters ()
    :precondition (and (not (done_er_registration)) (not (pending_er_registration_er_sepsis_triage)))
    :effect (and (done_er_registration) (first) (last_er_registration) (next_er_triage) (not (next_er_registration)) (not (pending_lacticacid_er_registration)) (pending_er_registration_crp) (pending_er_registration_er_sepsis_triage) (pending_er_registration_leucocytes) (unique_er_registration))
  )

  (:action er_sepsis_triage
    :parameters ()
    :precondition (and (done_er_registration) (done_er_triage) (first) (last_er_triage) (next_er_sepsis_triage) (not (done_er_sepsis_triage)) (pending_er_registration_er_sepsis_triage))
    :effect (and (done_er_sepsis_triage) (last_er_sepsis_triage) (not (last_er_triage)) (not (next_er_sepsis_triage)) (not (pending_crp_er_sepsis_triage)) (not (pending_er_registration_er_sepsis_triage)) (not (pending_lacticacid_er_sepsis_triage)) (not (pending_leucocytes_er_sepsis_triage)) (pending_er_sepsis_triage_crp) (pending_er_sepsis_triage_leucocytes) (unique_er_sepsis_triage) (when (not (done_crp)) (pending_er_sepsis_triage_crp)) (when (not (done_leucocytes)) (pending_er_sepsis_triage_leucocytes)) (when (not (unique_er_registration)) (pending_er_sepsis_triage_er_registration)))
  )

  (:action er_triage
    :parameters ()
    :precondition (and (done_er_registration) (first) (last_er_registration) (next_er_triage) (not (done_er_triage)))
    :effect (and (done_er_triage) (last_er_triage) (next_er_sepsis_triage) (not (last_er_registration)) (not (next_er_triage)) (not (pending_lacticacid_er_triage)) (pending_er_triage_crp) (pending_er_triage_leucocytes) (unique_er_triage))
  )

  (:action iv_antibiotics
    :parameters ()
    :precondition (and (first))
    :effect (and (done_iv_antibiotics) (not (pending_lacticacid_iv_antibiotics)) (when (not (done_lacticacid)) (pending_iv_antibiotics_lacticacid)))
  )

  (:action lacticacid
    :parameters ()
    :precondition (and (done_er_registration) (done_er_triage) (first))
    :effect (and (done_lacticacid) (not (pending_crp_lacticacid)) (not (pending_iv_antibiotics_lacticacid)) (when (not (done_crp)) (pending_lacticacid_crp)) (when (not (done_er_registration)) (pending_lacticacid_er_registration)) (when (not (done_er_sepsis_triage)) (pending_lacticacid_er_sepsis_triage)) (when (not (done_er_triage)) (pending_lacticacid_er_triage)) (when (not (done_iv_antibiotics)) (pending_lacticacid_iv_antibiotics)) (when (not (done_leucocytes)) (pending_lacticacid_leucocytes)))
  )

  (:action leucocytes
    :parameters ()
    :precondition (and (done_er_registration) (done_er_triage) (first))
    :effect (and (done_leucocytes) (not (pending_crp_leucocytes)) (not (pending_er_registration_leucocytes)) (not (pending_er_sepsis_triage_leucocytes)) (not (pending_er_triage_leucocytes)) (not (pending_lacticacid_leucocytes)) (when (not (done_crp)) (pending_leucocytes_crp)) (when (not (done_er_sepsis_triage)) (pending_leucocytes_er_sepsis_triage)))
  )

  (:action release_b
    :parameters ()
    :precondition (and (first) (forbidden))
    :effect (and )
  )

  (:action release_c
    :parameters ()
    :precondition (and (first) (forbidden))
    :effect (and )
  )

  (:action release_d
    :parameters ()
    :precondition (and (first) (forbidden))
    :effect (and )
  )

  (:action release_e
    :parameters ()
    :precondition (and (first) (forbidden))
    :effect (and )
  )

)