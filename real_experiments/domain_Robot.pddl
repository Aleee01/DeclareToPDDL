(define (domain declare_full)
  (:requirements :strips :negative-preconditions)
  (:predicates
    (first)
    (forbidden)
    (ended)
    (done_drop)
    (next_drop)
    (last_drop)
    (unique_drop)
    (done_grasp)
    (next_grasp)
    (last_grasp)
    (unique_grasp)
    (done_hold)
    (next_hold)
    (last_hold)
    (unique_hold)
    (done_lower)
    (next_lower)
    (last_lower)
    (unique_lower)
    (done_pick)
    (next_pick)
    (last_pick)
    (unique_pick)
    (done_shake)
    (next_shake)
    (last_shake)
    (unique_shake)
    (pending_drop_grasp)
    (pending_drop_hold)
    (pending_drop_lower)
    (pending_drop_pick)
    (pending_drop_shake)
    (pending_grasp_drop)
    (pending_grasp_hold)
    (pending_grasp_lower)
    (pending_grasp_pick)
    (pending_grasp_shake)
    (pending_hold_drop)
    (pending_hold_grasp)
    (pending_hold_lower)
    (pending_hold_pick)
    (pending_hold_shake)
    (pending_lower_drop)
    (pending_lower_grasp)
    (pending_lower_hold)
    (pending_lower_pick)
    (pending_lower_shake)
    (pending_pick_drop)
    (pending_pick_grasp)
    (pending_pick_hold)
    (pending_pick_lower)
    (pending_pick_shake)
    (pending_shake_drop)
    (pending_shake_grasp)
    (pending_shake_hold)
    (pending_shake_lower)
    (pending_shake_pick)
  )

  (:action drop
    :parameters ()
    :precondition (and (done_grasp) (done_hold) (done_lower) (done_pick) (done_shake) (first) (not (done_drop)) (pending_lower_drop))
    :effect (and (done_drop) (not (pending_grasp_drop)) (not (pending_hold_drop)) (not (pending_lower_drop)) (not (pending_pick_drop)) (not (pending_shake_drop)) (unique_drop) (when (not (unique_lower)) (pending_drop_lower)))
  )

  (:action grasp
    :parameters ()
    :precondition (and )
    :effect (and (done_grasp) (first) (not (pending_lower_grasp)) (not (pending_shake_grasp)) (pending_grasp_drop) (pending_grasp_hold) (pending_grasp_pick) (when (not (done_shake)) (pending_grasp_shake)))
  )

  (:action hold
    :parameters ()
    :precondition (and (done_grasp) (done_pick) (first))
    :effect (and (done_hold) (not (pending_grasp_hold)) (not (pending_lower_hold)) (not (pending_pick_hold)) (not (pending_shake_hold)) (pending_hold_drop) (when (not (done_shake)) (pending_hold_shake)))
  )

  (:action lower
    :parameters ()
    :precondition (and (done_grasp) (done_hold) (done_pick) (done_shake) (first) (not (done_lower)) (not (pending_lower_drop)))
    :effect (and (done_lower) (pending_lower_drop) (pending_lower_hold) (unique_lower) (when (not (done_drop)) (pending_lower_drop)) (when (not (done_grasp)) (pending_lower_grasp)) (when (not (done_hold)) (pending_lower_hold)) (when (not (done_pick)) (pending_lower_pick)) (when (not (done_shake)) (pending_lower_shake)))
  )

  (:action pick
    :parameters ()
    :precondition (and (done_grasp) (first))
    :effect (and (done_pick) (not (pending_grasp_pick)) (not (pending_lower_pick)) (not (pending_shake_pick)) (pending_pick_drop) (pending_pick_hold) (when (not (done_shake)) (pending_pick_shake)))
  )

  (:action shake
    :parameters ()
    :precondition (and (done_grasp) (done_hold) (done_pick) (first))
    :effect (and (done_shake) (not (pending_grasp_shake)) (not (pending_hold_shake)) (not (pending_lower_shake)) (not (pending_pick_shake)) (pending_shake_drop) (pending_shake_hold) (when (not (done_grasp)) (pending_shake_grasp)) (when (not (done_hold)) (pending_shake_hold)) (when (not (done_pick)) (pending_shake_pick)))
  )

)