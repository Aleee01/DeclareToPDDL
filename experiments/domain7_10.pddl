(define (domain declare_full)
  (:requirements :strips :negative-preconditions)
  (:predicates
    (first)
    (forbidden)
    (ended)
    (done_act_a)
    (next_act_a)
    (last_act_a)
    (unique_act_a)
    (done_act_b)
    (next_act_b)
    (last_act_b)
    (unique_act_b)
    (done_act_c)
    (next_act_c)
    (last_act_c)
    (unique_act_c)
    (done_act_d)
    (next_act_d)
    (last_act_d)
    (unique_act_d)
    (done_act_e)
    (next_act_e)
    (last_act_e)
    (unique_act_e)
    (done_act_f)
    (next_act_f)
    (last_act_f)
    (unique_act_f)
    (done_act_g)
    (next_act_g)
    (last_act_g)
    (unique_act_g)
    (done_act_h)
    (next_act_h)
    (last_act_h)
    (unique_act_h)
    (done_act_i)
    (next_act_i)
    (last_act_i)
    (unique_act_i)
    (done_act_l)
    (next_act_l)
    (last_act_l)
    (unique_act_l)
    (pending_act_a_act_b)
    (pending_act_a_act_d)
    (pending_act_b_act_a)
    (pending_act_b_act_c)
    (pending_act_c_act_b)
    (pending_act_c_act_d)
    (pending_act_c_act_e)
    (pending_act_d_act_a)
    (pending_act_d_act_c)
    (pending_act_e_act_c)
  )

  (:action act_a
    :parameters ()
    :precondition (and (not (done_act_d)) (not (pending_act_a_act_b)))
    :effect (and (done_act_a) (pending_act_a_act_b))
  )

  (:action act_b
    :parameters ()
    :precondition (and )
    :effect (and (done_act_b) (not (pending_act_a_act_b)))
  )

  (:action act_c
    :parameters ()
    :precondition (and (not (done_act_e)))
    :effect (and (done_act_c) (last_act_c))
  )

  (:action act_d
    :parameters ()
    :precondition (and (done_act_c) (last_act_c) (not (done_act_d)))
    :effect (and (done_act_d) (last_act_d) (not (last_act_c)) (unique_act_d))
  )

  (:action act_e
    :parameters ()
    :precondition (and (not (done_act_c)))
    :effect (and (done_act_e))
  )

  (:action act_f
    :parameters ()
    :precondition (and )
    :effect (and (done_act_f))
  )

  (:action act_g
    :parameters ()
    :precondition (and )
    :effect (and (done_act_g))
  )

  (:action act_h
    :parameters ()
    :precondition (and )
    :effect (and (done_act_h))
  )

  (:action act_i
    :parameters ()
    :precondition (and )
    :effect (and (done_act_i))
  )

  (:action act_l
    :parameters ()
    :precondition (and )
    :effect (and (done_act_l))
  )

)